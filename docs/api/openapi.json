 "info": {
  "description": "Stored HELIOS verdicts and the human decisions on them (S4.1). Never returns ground truth or metrics derived from it.",
  "title": "HELIOS API",
  "version": "api-v1.2"
 },
 "openapi": "3.1.0",
 "paths": {
  "/health": {
   "get": {
    "operationId": "health_health_get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      },
      "description": "Successful Response"
     },
     "401": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "No or unknown API key"
     },
     "403": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "The key lacks the role"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Invalid request"
     }
    },
    "summary": "Health",
    "tags": [
     "health"
    ]
   }
  },
  "/v1/incidents": {
   "get": {
    "operationId": "incidents_v1_incidents_get",
    "parameters": [
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 50,
       "maximum": 500,
       "minimum": 1,
       "title": "Limit",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "offset",
      "required": false,
      "schema": {
       "default": 0,
       "minimum": 0,
       "title": "Offset",
       "type": "integer"
      }
     },
     {
      "in": "header",
      "name": "x-api-key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Api-Key"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/IncidentPage"
        }
       }
      },
      "description": "Successful Response"
     },
     "401": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "No or unknown API key"
     },
     "403": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "The key lacks the role"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      },
      "description": "Invalid request"
     }
    },
    "summary": "Incidents",
    "tags": [
     "incidents"
    ]
   }
  },
