   },
   "DecisionIn": {
    "additionalProperties": false,
    "properties": {
     "chosen_service": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "On reject: the service the reviewer believes is the root cause, from the ranked list, or 'none'. Set by the server on accept.",
      "title": "Chosen Service"
     },
     "client_hidden_ms": {
      "anyOf": [
       {
        "minimum": 0.0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "How long the page was hidden while the case was shown (K-d).",
      "title": "Client Hidden Ms"
     },
     "client_ms": {
      "anyOf": [
       {
        "minimum": 0.0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "The client's own timing, kept beside the server's.",
      "title": "Client Ms"
     },
     "decision": {
