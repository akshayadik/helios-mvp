{
 "components": {
  "schemas": {
   "ActionOut": {
    "additionalProperties": false,
    "description": "The run's remediation proposal (S4.5, S4.6). A recommendation only:\nHELIOS never carries it out in Stage A.",
    "properties": {
     "kind": {
      "description": "restart, scale-out, escalate-to-human or none.",
