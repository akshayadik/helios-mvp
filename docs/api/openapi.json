      "type": "string"
     },
     "mode": {
      "description": "recommend or shadow.",
      "title": "Mode",
      "type": "string"
     },
     "reason": {
      "title": "Reason",
      "type": "string"
     },
     "target": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Target"
     },
     "validation": {
      "description": "FGSV verdict: PASS, FAIL, STALE or UNVALIDATED.",
      "title": "Validation",
      "type": "string"
     }
    },
    "required": [
     "kind",
     "target",
     "mode",
     "validation",
     "reason"
    ],
    "title": "ActionOut",
    "type": "object"
   },
