# Copy this file to .env and replace the value below.
# The HMAC secret signs deviation_log.jsonl entries (C1 §6.5).
# MUST be at least 32 characters. NEVER commit .env.
DEVIATION_HMAC_SECRET=replace-with-32-plus-character-cryptographically-random-secret
# Ed25519 private key for deviation-log entries from entry 35 on (D7).
# Generate once with: poetry run python bin/log_deviation.py keygen >> .env
# The matching public key is committed at keys/deviation_log_ed25519.pub.pem.
DEVIATION_ED25519_PRIVATE_KEY=replace-with-keygen-output
