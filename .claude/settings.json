{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python .claude/hooks/research-compliance.py"
                    }
                ]
            },
            {
                "matcher": "Write|Edit|MultiEdit|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python .claude/hooks/flag-guard.py"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/auto-test-and-log.sh"
                    }
                ]
            },
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/format-and-matrix-update.sh"
                    }
                ]
            }
        ]
    },
    "defaultModel": "claude-4-sonnet-2025",
    "modelPreferences": {
        "complexReasoning": "claude-4-opus-2025",
        "crossPipeline": "claude-4-opus-2025",
        "finalAnalysis": "claude-4-opus-2025"
    },
    "allowedTools": [
        "Read",
        "Edit",
        "MultiEdit",
        "Bash",
        "Grep",
        "ListFiles",
        "Task",
        "Search"
    ]
}