# RCAEval baseline environment, "default" mode (Python 3.12): BARO,
# multi-source BARO, TraceRCA, CIRCA, CausalRCA, PDiagnose source.
# Isolated from the HELIOS environment (D5, S0.11). Base image and RCAEval
# commit are pinned; change either only with a deviation entry.
FROM python@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
ARG RCAEVAL_COMMIT=2fca61b9730a69c21ef72411844735634dbb010f
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends git build-essential libxml2 libxml2-dev zlib1g-dev graphviz \
 && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/phamquiluan/RCAEval.git /opt/RCAEval \
 && git -C /opt/RCAEval checkout --quiet "${RCAEVAL_COMMIT}"
WORKDIR /opt/RCAEval
# constraints-default.txt is the resolved set from the S0.11 spike (RCAEval's
# requirements.txt uses open ranges); it keeps rebuilds identical.
COPY constraints-default.txt /opt/constraints-default.txt
RUN pip install --no-cache-dir -c /opt/constraints-default.txt -e ".[default]" \
 && pip freeze > /opt/pip-freeze.txt
